{
	"name": "@feather/domain",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./tweet": {
			"types": "./dist/tweet/index.d.ts",
			"default": "./src/tweet/index.ts"
		}
	},
	"license": "MIT",
	"scripts": {
		"build": "tsc",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc",
		"lint": "biome lint",
		"format": "biome format",
		"check": "biome check",
		"check:fix": "biome check --write",
		"check:unsafe:fix": "biome check --write --unsafe",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"with-env": "dotenv -e ../../.env --"
	},
	"dependencies": {
		"@feather/db": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@feather/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
